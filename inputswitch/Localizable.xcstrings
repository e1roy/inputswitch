    "Press and release the key on its own to move to the next input source. Shortcuts that use the key, like ⌘C, keep working as usual.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and release the key on its own to move to the next input source. Shortcuts that use the key, like ⌘C, keep working as usual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーだけを押して離すと、次の入力ソースに切り替わります。⌘C などのショートカットは通常どおり使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独按下并松开该键即可切换到下一个输入法。使用该键的组合快捷键（如 ⌘C）不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單獨按下並放開該鍵即可切換到下一個輸入法。使用該鍵的組合快速鍵（如 ⌘C）不受影響。"
          }
        }
      }
    },
