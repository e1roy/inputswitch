    "macOS requires Accessibility access for InputSwitch to notice when you tap a modifier key. InputSwitch never records what you type.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS requires Accessibility access for InputSwitch to notice when you tap a modifier key. InputSwitch never records what you type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーのタップを検知するため、macOS のアクセシビリティ許可が必要です。InputSwitch が入力内容を記録することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要辅助功能权限，InputSwitch 才能感知你轻按修饰键。InputSwitch 绝不会记录你输入的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要輔助使用權限，InputSwitch 才能偵測你輕按修飾鍵。InputSwitch 絕不會記錄你輸入的內容。"
          }
        }
      }
    },
