        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戻るには、アプリケーション、Launchpad、または Spotlight から InputSwitch をもう一度開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
