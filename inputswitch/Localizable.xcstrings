    "Colors for each input source can be set in Input Sources.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors for each input source can be set in Input Sources."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力ソースごとの色は「入力ソース」で設定できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在“输入法”页面为每个输入法单独设置颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在「輸入法」頁面為每個輸入法個別設定顏色。"
          }
        }
      }
    },
