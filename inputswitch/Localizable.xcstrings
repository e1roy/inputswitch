    "About": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於"
          }
        }
      }
    },
    "Add input sources in System Settings › Keyboard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add input sources in System Settings › Keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定 › キーボード」で入力ソースを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 › 键盘”中添加输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 › 鍵盤」中加入輸入法。"
          }
        }
      }
    },
    "Always know which input source you’re typing in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always know which input source you’re typing in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今どの入力ソースで入力しているかが、ひと目でわかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时知道自己正在用哪个输入法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時知道自己正在使用哪個輸入法。"
          }
        }
      }
    },
