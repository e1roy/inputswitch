    "Input source switching and the HUD stop working until InputSwitch is opened again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input source switching and the HUD stop working until InputSwitch is opened again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "InputSwitch を再度開くまで、入力ソースの切り替えと HUD は動作しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后，快捷切换和 HUD 将停止工作，直到再次打开 InputSwitch。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束後，快速切換和 HUD 將停止運作，直到再次開啟 InputSwitch。"
          }
        }
      }
    },
